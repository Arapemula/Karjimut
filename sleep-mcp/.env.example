# =====================================================================
# Karjimut - Konfigurasi Environment
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# =====================================================================

# --- Database SQLite (WAL mode) -------------------------------------
# Path absolut / relatif terhadap folder sleep-mcp/. Dipakai bersama oleh
# MCP Server, Idle Watcher, dan Aplikasi Desktop Native (CustomTkinter).
SLEEP_MCP_DB_PATH=data/sleep_mcp.db

# --- Batas Memori Lapis 1 (Elastic Core) -----------------------------
# 0 = Elastic Core (fleksibel menyesuaikan skala proyek tanpa pemotongan paksa)
# >0 = Batas maksimum token keras (mis. 150 atau 300)
KTP_MAX_TOKENS=0
# 0 = Otomatis mengikuti mode (tanpa batas jumlah aturan saat Elastic Core KTP_MAX_TOKENS=0;
#     atau batas default 12 aturan saat mode KTP terbatas aktif). Isi >0 untuk batas aturan eksplisit.
KTP_MAX_RULES=0

# --- Siklus Idle / Sleep Cycle ---------------------------------------
# Durasi tanpa log baru sebelum Sleep Cycle otomatis berjalan (detik).
IDLE_TIMEOUT_SECONDS=300
# Interval pemeriksaan Idle Watcher (detik).
IDLE_POLL_INTERVAL_SECONDS=10
# Batas usia kunci status_rangkum=1 sebelum dianggap zombie (menit).
STALE_LOCK_MINUTES=3
# Jumlah maksimum log mentah per batch konsolidasi.
SLEEP_BATCH_LIMIT=200
# Jendela waktu (detik) setelah log terakhir yang dianggap status "Working".
WORKING_WINDOW_SECONDS=60
# Jalankan Idle Watcher sebagai thread di dalam proses MCP Server (true/false).
SLEEP_MCP_EMBEDDED_WATCHER=true

# --- LLM Consolidator ------------------------------------------------
# LLM_PROVIDER: gemini (native Google AI) | anthropic (native) |
#               openai (OpenAI-compatible: OpenAI, Groq, OpenRouter, Ollama /v1, LM Studio) |
#               ollama (native Ollama)
# Catatan: Onboarding 1-kolom GUI mengisi 3 variabel berikut otomatis dari prefix API key.
LLM_PROVIDER=gemini
# Contoh Gemini : https://generativelanguage.googleapis.com/v1beta
# Contoh OpenAI : https://api.openai.com/v1
# Contoh Groq   : https://api.groq.com/openai/v1
# Contoh Ollama : http://localhost:11434
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=
LLM_MODEL_NAME=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
# true = paksa selalu gunakan local_rule_based_distiller (100% offline) meskipun API key terisi.
# false = otomatis gunakan LLM jika LLM_API_KEY terisi (atau Ollama lokal), dan otomatis fallback ke
#         local_rule_based_distiller jika LLM_API_KEY masih kosong.
USE_LOCAL_FALLBACK=false
# true = jika panggilan LLM gagal, lanjutkan dengan distiller lokal.
# false = batch dikembalikan ke status_rangkum=0 (sesuai Blueprint).
FALLBACK_LOCAL_ON_LLM_ERROR=false

# --- Tokenizer -------------------------------------------------------
# true = paksa estimator subword deterministik (tanpa tiktoken).
FORCE_FALLBACK_TOKENIZER=false

# --- Keamanan Team Memory (.karjimut/team_memory.json) ----------------
# Opsional: kunci rahasia tim untuk tanda tangan HMAC-SHA256 pada team_memory.json.
# Jangan pernah commit nilai ini ke Git. Bisa diisi di sini (global) atau di .env workspace.
KARJIMUT_TEAM_SECRET=
# true = tolak keras semua team_memory.json yang tidak memiliki signature HMAC valid.
KARJIMUT_REQUIRE_TEAM_SIGNATURE=false
# true = izinkan penggabungan Aturan: dari team_memory.json tanpa signature (tidak disarankan untuk repo publik).
KARJIMUT_TRUST_UNSIGNED_TEAM_RULES=false

# --- Logging ---------------------------------------------------------
LOG_LEVEL=INFO
